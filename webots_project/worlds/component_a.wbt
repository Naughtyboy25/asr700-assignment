# Robot (e-puck)
Robot {
  translation 1 0.05 1
  rotation 0 1 0 0
  name "e-puck"
  controller "robot_controller_a"
  supervisor FALSE
  synchronization TRUE
  selfCollision FALSE
  children [
    # e-puck model would be defined here or referenced from protos
  ]
}

# Light
PointLight {
  location 5 5 5
  color 1 1 1
  intensity 1
  radius 20
}

# Additional ambient lighting
PointLight {
  location 5 3 5
  color 1 1 1
  intensity 0.5
  radius 15
}