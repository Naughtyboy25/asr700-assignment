#VRML_SIM R2025a utf8

WorldInfo {
  coordinateSystem "NUE"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction 0.8
      bounce 0.01
      bounceVelocity 0.01
      forceDependentSlip 0
      softERP 0.2
      softCFM 0.0001
    }
  ]
  basicTimeStep 32
  fast false
  fastPhysics false
}

Viewpoint {
  orientation 1 0 0 -1.5708
  position 5 15 5
  description "Top View"
}

Viewpoint {
  orientation 0 0 1 0
  position 5 2 10
  description "Side View"
}

Viewpoint {
  orientation 0 1 0 0
  position 10 2 5
  description "Front View"
}

Viewpoint {
  orientation 0 0 1 0
  position 5 1.5 5
  description "Robot View"
}

Background {
  skyColor [0.4, 0.6, 0.8]
}

# Floor
Solid {
  translation 5 0 5
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.8 0.8 0.8
          ambientIntensity 0.3
        }
        texture ImageTexture {
          url ["floor.jpg"]
        }
      }
      geometry Box {
        size 10 0.02 10
      }
    }
  ]
  boundingObject Box {
    size 10 0.02 10
  }
  physics Physics {
    density 0
  }
}

# Walls
Solid {
  translation 5 0.5 0
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.5 0.5 0.5
        }
      }
      geometry Box {
        size 10 1 0.1
      }
    }
  ]
  boundingObject Box {
    size 10 1 0.1
  }
  physics Physics {
    density 0
  }
}

Solid {
  translation 5 0.5 10
