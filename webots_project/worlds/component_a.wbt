      }
    }
  ]
  boundingObject Box {
    size 10 0.1 1
  }
}

# Obstacles
# Obstacle 1 - Left wall area
Solid {
  translation 5 3 0.5
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.3 0.3 0.7
        }
      }
      geometry Cylinder {
        radius 0.5
        height 1
      }
    }
  ]
  boundingObject Cylinder {
    radius 0.5
    height 1
  }
  physics Physics {
    density 1000
  }
}

