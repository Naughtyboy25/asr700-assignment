    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.5 0.5 0.5
        }
      }
      geometry Box {
        size 0.1 1 10
      }
    }
  ]
  boundingObject Box {
    size 0.1 1 10
  }
  physics Physics {
    density 0
  }
}

# Obstacles
# Obstacle 1 - Left wall area
Solid {
  translation 3 0.5 5
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.3 0.3 0.7
        }
      }
      geometry Cylinder {
        radius 0.5
        height 1
      }
    }
  ]
  boundingObject Cylinder {
    radius 0.5
    height 1
  }
  physics Physics {
    density 1000
  }
}

