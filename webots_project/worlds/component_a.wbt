Solid {
  translation 3.5 3.5 0.15
  name "landmark_yellow"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.95 0.85 0.1
          roughness 0.5
          metalness 0
        }
        geometry Cylinder {
