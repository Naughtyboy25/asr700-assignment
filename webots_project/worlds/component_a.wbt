#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  info [
    "ASR700 Component A - Single Robot Navigation"
  ]
  basicTimeStep 32
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [
        1
      ]
      bounce 0.1
      softCFM 0.0001
    }
  ]
}

Viewpoint {
  orientation -0.4 0.4 0.82 1.2
  position -2 8 10
}

Background {
  skyColor [0.5 0.7 0.9]
}

DirectionalLight {
  direction -0.3 -0.5 -1
  intensity 1.2
  ambientIntensity 0.8
  castShadows TRUE
}

# Clean arena floor + walls
RectangleArena {
  translation 0 0 0
  floorSize 10 10
  floorTileSize 1 1
  wallHeight 0.4
  wallThickness 0.08
}

# Obstacles (boxes sitting on the floor)
Solid {
  translation -2 0 0.25
  name "obstacle_1"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.35 0.35 0.4
          roughness 0.8
          metalness 0
        }
        geometry Box {
          size 1.2 2.5 0.5
        }
      }
    }
  ]
  boundingObject Box {
    size 1.2 2.5 0.5
  }
}

Solid {
  translation 2 -1.5 0.25
  name "obstacle_2"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.35 0.35 0.4
          roughness 0.8
          metalness 0
        }
        geometry Box {
          size 1.5 1.2 0.5
        }
      }
    }
  ]
  boundingObject Box {
    size 1.5 1.2 0.5
  }
}

Solid {
  translation 0 2 0.25
  name "obstacle_3"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.35 0.35 0.4
          roughness 0.8
          metalness 0
        }
        geometry Box {
          size 2.0 1.0 0.5
        }
      }
    }
  ]
  boundingObject Box {
    size 2.0 1.0 0.5
  }
}

Solid {
  translation 2.5 2 0.25
  name "obstacle_4"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.35 0.35 0.4
          roughness 0.8
          metalness 0
        }
        geometry Box {
          size 1.0 1.5 0.5
        }
      }
    }
  ]
  boundingObject Box {
    size 1.0 1.5 0.5
  }
}

# Coloured landmarks for camera detection
Solid {
  translation -3.5 -3.5 0.15
  name "landmark_red"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.1 0.1
          roughness 0.5
          metalness 0
        }
        geometry Cylinder {
          height 0.3
          radius 0.12
        }
      }
    }
  ]
  boundingObject Cylinder {
    height 0.3
    radius 0.12
  }
}

Solid {
  translation -3.5 3.5 0.15
  name "landmark_green"
  children [
    Shape {
      appearance Appearance {
