          roughness 0.5
          metalness 0
        }
        geometry Cylinder {
          height 0.3
          radius 0.12
        }
      }
    }
  ]
  boundingObject Cylinder {
    height 0.3
    radius 0.12
  }
}

Solid {
  translation 3.5 -3.5 0.15
  name "landmark_blue"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.1 0.3 0.9
          roughness 0.5
          metalness 0
        }
        geometry Cylinder {
          height 0.3
          radius 0.12
        }
      }
    }
  ]
  boundingObject Cylinder {
    height 0.3
