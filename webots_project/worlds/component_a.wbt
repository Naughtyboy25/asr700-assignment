# Robot (e-puck)
E-puck {
  translation 1 1 0
  rotation 0 0 1 0
  name "e-puck"
  controller "robot_controller_a"
  extensionSlot [
    GPS {
      name "gps"
    }
    InertialUnit {
      name "inertial unit"
    }
    Lidar {
      translation 0 0 0.03
      name "lidar"
      horizontalResolution 360
      fieldOfView 6.2832
      numberOfLayers 1
      minRange 0.05
      maxRange 3
    }
    Emitter {
      name "emitter"
      channel 1
    }
    Receiver {
      name "receiver"
      channel 1
    }
  ]
}

# Light
PointLight {
  location 5 5 3
  color 1 1 1
  intensity 1
  radius 20
}

# Additional ambient lighting
PointLight {
  location 5 5 3
  color 1 1 1
  intensity 0.5
  radius 15
}