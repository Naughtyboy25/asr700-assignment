# Goal marker (visual only)
Solid {
  translation 3.5 3.5 0.01
  name "goal_marker"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.1 0.9 0.3
          roughness 1
          metalness 0
          transparency 0.4
        }
        geometry Cylinder {
          height 0.02
          radius 0.25
        }
      }
    }
  ]
}

# E-puck robot – start near bottom-left of arena
E-puck {
  translation -3.5 -3.5 0
  rotation 0 0 1 0.785
  name "e-puck"
  controller "robot_controller_a"
  supervisor FALSE
  turretSlot [
    GPS {
      name "gps"
    }
    InertialUnit {
      name "inertial unit"
    }
    Lidar {
      translation 0 0 0.04
      name "lidar"
      horizontalResolution 180
      fieldOfView 6.28318
      numberOfLayers 1
      minRange 0.05
      maxRange 2.5
      type "fixed"
    }
  ]
}

# Lighting
DirectionalLight {
  direction -0.3 -0.5 -1
  intensity 1.2
  ambientIntensity 0.8
  castShadows TRUE
}

PointLight {
  location 5 5 3
  color 1 1 1
  intensity 1
  radius 20
  attenuation 0 0 1
}

PointLight {
  location 5 5 3
  color 1 1 1
  intensity 0.5
  radius 15
  attenuation 0 0 1
}