#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction 0.8
      bounce 0.01
      bounceVelocity 0.01
      forceDependentSlip 0
      softERP 0.2
      softCFM 0.0001
    }
  ]
  basicTimeStep 32
}

Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position -5 5 12
  description "Top View"
}

Background {
  skyColor [0.4 0.6 0.8]
}

# Floor
Solid {
  translation 5 5 0
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.8 0.8 0.8
          ambientIntensity 0.3
        }
      }
      geometry Box {
        size 10 10 0.02
      }
    }
  ]
  boundingObject Box {
    size 10 10 0.02
  }
}

# Walls
Solid {
  translation 0 5 0.5
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.5 0.5 0.5
        }
      }
      geometry Box {
        size 0.1 10 1
      }
    }
  ]
  boundingObject Box {
    size 0.1 10 1
  }
}

Solid {
