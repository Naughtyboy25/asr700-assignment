  direction -0.3 -0.5 -1
  intensity 1.2
  ambientIntensity 0.8
  castShadows FALSE
}

PointLight {
  location 5 5 3
  color 1 1 1
  intensity 1
  radius 20
  attenuation 0 0 1
}

PointLight {
  location 5 5 3
  color 1 1 1
  intensity 0.5
  radius 15
  attenuation 0 0 1
}