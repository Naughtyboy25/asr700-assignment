# LEADER ROBOT (Agent 0)
E-puck {
  translation 1 1 0
  rotation 0 0 1 0
  name "e-puck_leader"
  controller "swarm_agents"
  controllerArgs ["leader"]
  turretSlot [
    GPS {
      name "gps"
    }
    InertialUnit {
      name "inertial unit"
    }
    Lidar {
      translation 0 0 0.03
      name "lidar"
      horizontalResolution 360
      fieldOfView 6.2832
      numberOfLayers 1
      minRange 0.05
      maxRange 3
    }
    Emitter {
      name "emitter_0"
      channel 1
    }
    Receiver {
      name "receiver_0"
      channel 1
    }
  ]
}

