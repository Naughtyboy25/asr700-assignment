# LEADER ROBOT (Agent 0)
Robot {
  translation 1 0.05 1
  rotation 0 1 0 0
  name "e-puck_leader"
  controller "leader_controller"
  supervisor FALSE
  synchronization TRUE
  selfCollision FALSE
  children [
    # e-puck model
  ]
}

