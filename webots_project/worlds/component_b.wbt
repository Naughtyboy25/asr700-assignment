# Obstacles for swarm environment
# Central obstacle cluster
Solid {
  name "obstacle_center"
  translation 5 5 0.5
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.4 0.4 0.4
        }
      }
      geometry Box {
        size 2 2 1
      }
    }
  ]
  boundingObject Box {
    size 2 2 1
  }
  physics Physics {
    density 1000
  }
}

