#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  info [
    "ASR700 Component B - Multi-Agent Swarm"
  ]
  basicTimeStep 32
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [
        1
      ]
      bounce 0.1
      softCFM 0.0001
    }
  ]
}

Viewpoint {
  orientation -0.3574 0.3574 0.8629 1.7178
  position 0 -9 9
}

Background {
  skyColor [0.5 0.7 0.9]
}

DirectionalLight {
  ambientIntensity 0.6
  direction 0.3 -0.6 -1
  intensity 1.0
  castShadows TRUE
}

RectangleArena {
  translation 0 0 0
  floorSize 10 10
  floorTileSize 1 1
  wallHeight 0.4
  wallThickness 0.08
}

# Central obstacle
Solid {
  translation 0 0 0.25
  name "obstacle_center"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.35 0.4
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 1.5 1.5 0.5
      }
    }
  ]
  boundingObject Box {
    size 1.5 1.5 0.5
  }
}

# Corner obstacles
Solid {
  translation -2.5 -2.5 0.2
  name "obstacle_sw"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.4 0.35 0.35
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 1.0 1.0 0.4
      }
    }
  ]
  boundingObject Box {
    size 1.0 1.0 0.4
  }
}

Solid {
  translation 2.5 2.5 0.2
  name "obstacle_ne"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.4 0.35 0.35
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 1.0 1.0 0.4
      }
    }
  ]
  boundingObject Box {
    size 1.0 1.0 0.4
  }
}

# Coverage targets (visual cylinders)
Solid {
  translation -3 2 0.1
  name "target_1"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.2 0.2
        roughness 0.5
        metalness 0
      }
      geometry Cylinder {
        height 0.2
        radius 0.15
      }
    }
  ]
  boundingObject Cylinder {
    height 0.2
    radius 0.15
  }
}

Solid {
  translation 3 -2 0.1
  name "target_2"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.8 0.3
        roughness 0.5
        metalness 0
      }
      geometry Cylinder {
        height 0.2
        radius 0.15
      }
    }
  ]
  boundingObject Cylinder {
    height 0.2
    radius 0.15
  }
}

Solid {
  translation 2 3 0.1
  name "target_3"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.4 0.9
        roughness 0.5
        metalness 0
      }
      geometry Cylinder {
        height 0.2
        radius 0.15
      }
    }
  ]
  boundingObject Cylinder {
    height 0.2
    radius 0.15
  }
}

Solid {
  translation -2 -3 0.1
  name "target_4"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.8 0.1
        roughness 0.5
        metalness 0
      }
      geometry Cylinder {
        height 0.2
        radius 0.15
      }
    }
  ]
  boundingObject Cylinder {
    height 0.2
    radius 0.15
  }
}

# ---- LEADER ----
E-puck {
  translation -3.5 -1.5 0
  rotation 0 0 1 0.5
  name "e-puck_leader"
  controller "swarm_agents"
  controllerArgs [
    "leader"
  ]
  turretSlot [
    GPS {
      name "gps"
    }
    InertialUnit {
      name "inertial unit"
    }
    Lidar {
      translation 0 0 0.04
      name "lidar"
      horizontalResolution 120
      fieldOfView 6.28318
      numberOfLayers 1
      minRange 0.05
      maxRange 2.0
    }
    Emitter {
      name "emitter"
      channel 1
    }
    Receiver {
      name "receiver"
      channel 1
    }
  ]
}

